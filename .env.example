# Dentora landing site (LANDING-01). Copy to .env.local and fill in. Never commit .env.local.

# Backend origin; /api/v1 is added for you (it also works if you already end it with /api/v1).
# Local backend: http://127.0.0.1:8000. Production: the backend's https origin.
DENTORA_API_URL=http://127.0.0.1:8000

# Shared secret for the backend's signed refresh call to /api/revalidate. At least 16 characters, identical to the backend's
# LANDING_REVALIDATE_SECRET. Leave empty locally to disable on-demand refresh (the short safety cache still refreshes).
LANDING_REVALIDATE_SECRET=

# Signs every forwarded form (backend W65) so the backend counts its form limit per visitor, whatever address this server calls
# from (needed on Vercel). At least 32 characters, identical to the backend's LANDING_FORMS_SECRET, different from the
# revalidate secret. Empty: forms are sent unsigned and the backend falls back to the calling address.
LANDING_FORMS_SECRET=

# Optional: where "Start a free trial" buttons go. Leave empty to open the trial request form on the Contact page
# (/contact#trial-interest). Only set it to a real self-service sign-up page; the clinic portal itself has no sign-up.
PORTAL_TRIAL_URL=

# This site's public origin, used for canonical URLs, hreflang, the sitemap and the same-origin check on form submits.
SITE_URL=http://localhost:3000

# Visitor address for the backend's per-address form limit. Set exactly ONE, and only when something you control in front of
# this server always overwrites it; if both are set the header wins and the server logs a warning.
#   On Vercel: LANDING_CLIENT_IP_HEADER=x-real-ip, and nothing else (Vercel sets it to the visitor address).
#   LANDING_TRUSTED_PROXY_HOPS=1       self-hosted: number of reverse proxies you run that append to X-Forwarded-For
#   LANDING_CLIENT_IP_HEADER=cf-connecting-ip   only when the origin cannot be reached except through that CDN; on Vercel that
#                                      also means protecting the *.vercel.app and deployment URLs, or visitors pick their own address.
# With neither set (fine locally) the backend sees this server's address, so every visitor shares one form limit; with
# DENTORA_API_URL set the server logs one warning per process about it. Addresses with a zone ID (%) are never used.
LANDING_TRUSTED_PROXY_HOPS=
LANDING_CLIENT_IP_HEADER=

# Local only (never set on Vercel: the demo build is committed in public/demo/app).
# Where `npm run sync:demo` reads the clinic portal demo build from (run `npm run build:demo` in the portal first).
PORTAL_DEMO_DIST=../.worktrees/clinic-portal-p4/dist-demo
