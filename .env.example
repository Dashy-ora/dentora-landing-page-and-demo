# Dentora landing site (LANDING-01). Copy to .env.local and fill in. Never commit .env.local.

# Backend origin; /api/v1 is added for you (it also works if you already end it with /api/v1).
# Local backend: http://127.0.0.1:8000. Production: the backend's https origin.
DENTORA_API_URL=http://127.0.0.1:8000

# Shared secret for the backend's signed refresh call to /api/revalidate. At least 16 characters, identical to the backend's
# LANDING_REVALIDATE_SECRET. Leave empty locally to disable on-demand refresh (the short safety cache still refreshes).
LANDING_REVALIDATE_SECRET=

# Optional: where "Start a free trial" buttons go. Leave empty to open the trial request form on the Contact page
# (/contact#trial-interest). Only set it to a real self-service sign-up page; the clinic portal itself has no sign-up.
PORTAL_TRIAL_URL=

# This site's public origin, used for canonical URLs, hreflang, the sitemap and the same-origin check on form submits.
SITE_URL=http://localhost:3000

# Optional: visitor address for the backend's per-address form limit. Pick ONE, and only if a proxy/CDN you control sits in
# front of this server and overwrites the header; otherwise leave both unset (the backend then sees this server's address).
#   LANDING_TRUSTED_PROXY_HOPS=1       number of reverse proxies that append to X-Forwarded-For
#   LANDING_CLIENT_IP_HEADER=cf-connecting-ip
#   On Vercel: LANDING_CLIENT_IP_HEADER=x-real-ip (Vercel sets it to the visitor address and overwrites any value the visitor sends).
LANDING_TRUSTED_PROXY_HOPS=
LANDING_CLIENT_IP_HEADER=

# Local only (never set on Vercel: the demo build is committed in public/demo/app).
# Where `npm run sync:demo` reads the clinic portal demo build from (run `npm run build:demo` in the portal first).
PORTAL_DEMO_DIST=../.worktrees/clinic-portal-p4/dist-demo
